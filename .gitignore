# ─────────────────────────────────────────────────────────────────
# Multi-Agent Research Assistant — .gitignore
# ─────────────────────────────────────────────────────────────────

# ─── Virtual Environment ─────────────────────────────────────────
.venv/
venv/
env/
ENV/
.env
.env.local

# ─── Python Cache & Compiled Files ──────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ─── Jupyter & Notebooks ────────────────────────────────────────
.ipynb_checkpoints
*.ipynb_checkpoints
*.ipynb
.jupyter/

# ─── IDE & Editor Files ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace

# ─── Large Data Files (regenerate locally) ──────────────────────
# Raw papers & PDFs (too large for git, regenerate with collect_papers.py)
data/raw/
data/papers/
data/*.pdf
data/*.txt
test.pdf

# Generated FAISS embeddings (large binary, regenerate with build_index.py)
data/processed/embeddings/
data/processed/*.faiss
data/processed/*.pkl

# Q&A pairs (commit these — they represent Phase 1 work)
# data/processed/qa_pairs.json   <-- INCLUDED in git

# Processed chunks (large, regenerate with chunking pipeline)
data/processed/chunks.jsonl
data/processed/chunks_metadata.json

# ─── Model Checkpoints (too large for git — use Git LFS or HF Hub) ─
models/
*.bin
*.safetensors
*.pt
checkpoint-*/

# ─── Weights & Biases ────────────────────────────────────────────
wandb/

# ─── Logs ────────────────────────────────────────────────────────
logs/
*.log

# ─── Evaluation Results ──────────────────────────────────────────
evals/results/*.json
evals/*.json
evals/*.csv
!evals/results/*.md

# ─── System & OS Files ──────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
*.swp
*.swo
*~
.directory
Thumbs.db

# ─── Temporary Files ────────────────────────────────────────────
*.tmp
*.temp
*.bak
*.backup
*~
.~*

# ─── Secrets & Credentials ──────────────────────────────────────
.env
.env.*.local
secrets/
credentials/
*.key
*.pem
config/secrets.yaml

# ─── Package Manager ────────────────────────────────────────────
.pip-cache/
.poetry-cache/
.tox/

# ─── Testing & Coverage ─────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/

# ─── Output & Scratch Files ─────────────────────────────────────
outputs/
/results/
*.output
*.out
local/
scratch/
temp/
test_output/

# ─── Project Context (local dev notes, not for repo) ────────────
project_context_prompt.md
