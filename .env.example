# ═════════════════════════════════════════════════════════════════
# Multi-Agent Research Assistant — Environment Configuration
# ═════════════════════════════════════════════════════════════════

# ── Dual Backend Selector ───────────────────────────────────────
# Options:
#   "local"  : Uses fine-tuned Mistral-7B on NVIDIA GPU (Phase 1-4)
#   "gemini" : Uses Google Gemini Cloud API (runs on any CPU/laptop!)
LLM_BACKEND=local

# ── Gemini API Credentials ───────────────────────────────────────
# Required only when LLM_BACKEND=gemini.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Gemini Model Selection ──────────────────────────────────────
# Recommended: "gemini-1.5-flash" (fastest, free tier) or "gemini-1.5-pro"
GEMINI_MODEL=gemini-1.5-flash
